{
  "name": "belvitale-celuclin-visual-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --mode preview",
    "build:production": "tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:ab": "playwright test tests/e2e/quiz.spec.ts --grep \"experimento A/B\"",
    "test:production": "npm run build:production && node scripts/verify-production-assets.mjs",
    "capture": "node scripts/capture-final-evidence.mjs",
    "validate:quiz": "node scripts/generate-quiz-validation.mjs",
    "simulate:quiz-audience": "node scripts/simulate-quiz-audience.mjs",
    "capture:quiz": "node scripts/capture-quiz-evidence.mjs",
    "audit:quiz-checkouts": "node scripts/audit-quiz-checkouts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/fraunces": "^5.2.9",
    "preact": "^10.29.7",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4"
  }
}
